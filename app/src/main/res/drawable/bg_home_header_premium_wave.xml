<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="400dp"
    android:height="130dp"
    android:viewportWidth="400"
    android:viewportHeight="130">
    
    <!-- Layered Wave 1 (Base deep layer) -->
    <path
        android:pathData="M0,0 L400,0 L400,100 C300,130 100,90 0,120 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="0"
                android:endColor="#00A3FF"
                android:startColor="#0085FF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Main Gradient Wave Layer (Restored Original Blue & Angle) -->
    <path
        android:pathData="M0,0 L400,0 L400,90 C300,120 100,80 0,110 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="400"
                android:startY="110"
                android:endX="0"
                android:endY="0"
                android:type="linear">
                <item android:color="#0085FF" android:offset="0" />
                <item android:color="#00A3FF" android:offset="0.5" />
                <item android:color="#00D6A3" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Layered Wave 2 (Very subtle overlay to maintain depth without changing color) -->
    <path
        android:fillAlpha="0.05"
        android:fillColor="#FFFFFF"
        android:pathData="M0,0 L400,0 L400,80 C320,110 120,70 0,100 Z" />

    <!-- Soft Floating Bubbles / Droplets -->
    <path android:fillAlpha="0.12" android:fillColor="#FFFFFF" android:pathData="M55,35m-7,0a7,7 0 1,1 14,0a7,7 0 1,1 -14,0" />
    <path android:fillAlpha="0.08" android:fillColor="#FFFFFF" android:pathData="M310,25m-5,0a5,5 0 1,1 10,0a5,5 0 1,1 -10,0" />
    <path android:fillAlpha="0.15" android:fillColor="#FFFFFF" android:pathData="M190,55m-9,0a9,9 0 1,1 18,0a9,9 0 1,1 -18,0" />
    <path android:fillAlpha="0.10" android:fillColor="#FFFFFF" android:pathData="M370,75m-6,0a6,6 0 1,1 12,0a6,6 0 1,1 -12,0" />
    <path android:fillAlpha="0.06" android:fillColor="#FFFFFF" android:pathData="M45,85m-8,0a8,8 0 1,1 16,0a8,8 0 1,1 -16,0" />
    <path android:fillAlpha="0.12" android:fillColor="#FFFFFF" android:pathData="M240,20m-4,0a4,4 0 1,1 8,0a4,4 0 1,1 -8,0" />
    
</vector>
