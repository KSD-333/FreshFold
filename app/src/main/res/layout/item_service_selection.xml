<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItemRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/stroke_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Icon -->
        <ImageView
            android:id="@+id/ivItemIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_cloth_shirt_photo"
            android:scaleType="fitCenter"
            android:padding="4dp" />

        <!-- Name + price -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Shirt"
                android:textColor="@color/text_h1"
                android:textSize="16sp"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/tvItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="₹50 / piece"
                android:textColor="@color/brand_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Stepper + amount wrapper -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Stepper pill: [−]  qty  [+] -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_qty_stepper_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/btnRowMinus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_qty_btn_minus"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/brand_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvRowQuantity"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/text_h1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnRowPlus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_qty_btn_plus"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

            </LinearLayout>

            <!-- Amount — OUTSIDE the pill, visible only when count > 0 -->
            <TextView
                android:id="@+id/tvRowAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-black"
                android:text="₹0"
                android:textColor="#4A90E8"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
