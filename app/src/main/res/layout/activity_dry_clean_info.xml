<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_service_hero"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_btn_white"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Dry Cleaning"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_btn_white"
                android:padding="10dp"
                android:src="@drawable/home"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:cardBackgroundColor="#22FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#44FFFFFF"
                app:strokeWidth="1.5dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_dry_clean_new" />
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Safe Care for Premium Fabrics"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Chemical solvent cleaning for delicate and premium garments"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_white_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="✓ Fabric Safe"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag_white_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="💎 Premium"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <View android:layout_width="4dp" android:layout_height="22dp"
                    android:background="@drawable/bg_next_btn_gradient" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black" android:text="About This Service"
                    android:textColor="@color/text_h1" android:textSize="17sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif" android:lineSpacingMultiplier="1.6"
                    android:padding="18dp"
                    android:text="The Dry Cleaning service provides safe and professional cleaning for delicate and premium fabrics. The system manages the complete process digitally from order confirmation to final delivery with real-time tracking and status updates."
                    android:textColor="@color/text_body_dark" android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <View android:layout_width="4dp" android:layout_height="22dp"
                    android:background="@drawable/bg_next_btn_gradient" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black" android:text="How It Works"
                    android:textColor="@color/text_h1" android:textSize="17sp" />
            </LinearLayout>

            <!-- Step 1 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_info_row_icon">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:fontFamily="sans-serif-black"
                            android:text="1" android:textColor="@color/brand_primary" android:textSize="18sp" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black" android:text="Place Your Order"
                            android:textColor="@color/text_h1" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:fontFamily="sans-serif"
                            android:text="Select Dry Cleaning, add clothes to cart, and confirm with a suitable pickup date and time."
                            android:textColor="@color/text_muted" android:textSize="13sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_info_row_icon">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:fontFamily="sans-serif-black"
                            android:text="2" android:textColor="@color/brand_primary" android:textSize="18sp" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black" android:text="Pickup by Agent"
                            android:textColor="@color/text_h1" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:fontFamily="sans-serif"
                            android:text="A delivery agent visits your location, collects the clothes, and transports them to our dry cleaning center."
                            android:textColor="@color/text_muted" android:textSize="13sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 3 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_info_row_icon">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:fontFamily="sans-serif-black"
                            android:text="3" android:textColor="@color/brand_primary" android:textSize="18sp" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black" android:text="Inspection &amp; Sorting"
                            android:textColor="@color/text_h1" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:fontFamily="sans-serif"
                            android:text="Clothes are carefully inspected for fabric type, stains, and damage. Delicate fabrics like suits, silk, sarees, and jackets are separated for specialized treatment."
                            android:textColor="@color/text_muted" android:textSize="13sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 4 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_info_row_icon">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:fontFamily="sans-serif-black"
                            android:text="4" android:textColor="@color/brand_primary" android:textSize="18sp" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black" android:text="Dry Cleaning Process"
                            android:textColor="@color/text_h1" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:fontFamily="sans-serif"
                            android:text="Professional dry cleaning machines and chemical solvents remove stains, dirt, and odor while protecting delicate fabrics from damage and shrinkage."
                            android:textColor="@color/text_muted" android:textSize="13sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 5 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_info_row_icon">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:fontFamily="sans-serif-black"
                            android:text="5" android:textColor="@color/brand_primary" android:textSize="18sp" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black" android:text="Finishing, Packing &amp; Delivery"
                            android:textColor="@color/text_h1" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:fontFamily="sans-serif"
                            android:text="After quality check and steam pressing, clothes are hanger-packed or folded securely and delivered to your door with real-time tracking."
                            android:textColor="@color/text_muted" android:textSize="13sp" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="16dp"
        app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="28dp"
        app:cardElevation="12dp" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingHorizontal="20dp" android:paddingVertical="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="0.04"
                    android:text="STARTING FROM" android:textColor="@color/text_muted" android:textSize="10sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black" android:text="₹120 / item"
                    android:textColor="@color/brand_primary" android:textSize="20sp" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBookNow" android:layout_width="wrap_content"
                android:layout_height="52dp" app:cardCornerRadius="26dp"
                app:cardElevation="4dp" app:strokeWidth="0dp">
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:background="@drawable/bg_next_btn_gradient" android:paddingHorizontal="28dp"
                    android:fontFamily="sans-serif-black" android:gravity="center"
                    android:text="Book Now →" android:textColor="#FFFFFF" android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
