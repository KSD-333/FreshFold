<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_hero_deep"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- ══════════════════════════════════════
             HERO HEADER
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:paddingLeft="28dp"
            android:paddingRight="28dp">

            <!-- Logo + FreshFold + PREMIUM LAUNDRY — centered vertical stack -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@drawable/freshfoldlogo" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="FreshFold"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:letterSpacing="0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="PREMIUM LAUNDRY"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.12" />
            </LinearLayout>

            <!-- Thin divider -->
            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="14dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_header_divider" />

            <!-- Headline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif-black"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif"
                android:text="Join thousands of happy FreshFold members"
                android:textColor="#BFFFFFFF"
                android:textSize="12sp"
                android:gravity="center" />

            <!-- Badge pills row — centered -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_feature_pill"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="5dp"
                    android:text="✓ Free Pickup"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_feature_pill"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="5dp"
                    android:text="✓ 24h Delivery"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_feature_pill"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="5dp"
                    android:text="✓ Pro Care"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════
             WHITE FORM CARD — fills bottom, no scroll
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_login_form_card"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <!-- Step 1 header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_step_badge">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Personal Details"
                    android:textColor="@color/text_h1"
                    android:textSize="15sp"/>
            </LinearLayout>

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="Full Name"
                android:textColor="@color/text_body_dark"
                android:textSize="12sp"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/brand_primary" app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#F0F9FF" app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_profile_nav" app:startIconTint="@color/brand_primary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Enter full name"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_h1"
                    android:textColorHint="@color/text_hint_color"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mobile Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="Mobile Number"
                android:textColor="@color/text_body_dark"
                android:textSize="12sp"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/brand_primary"
                app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#F0F9FF"
                app:hintEnabled="false"
                app:prefixText="+91 "
                app:prefixTextColor="@color/brand_primary"
                app:prefixTextAppearance="@style/TextAppearance.MaterialComponents.Body1"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/brand_primary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Enter phone"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:textColor="@color/text_h1"
                    android:textColorHint="@color/text_hint_color"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="Email Address"
                android:textColor="@color/text_body_dark"
                android:textSize="12sp"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/brand_primary" app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#F0F9FF" app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_email" app:startIconTint="@color/brand_primary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Enter email"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_h1"
                    android:textColorHint="@color/text_hint_color"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email error message -->
            <TextView
                android:id="@+id/tvEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:paddingLeft="4dp"
                android:fontFamily="sans-serif"
                android:textColor="#FF3B30"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Step 2 header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp">
                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_step_badge">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Set Password"
                    android:textColor="@color/text_h1"
                    android:textSize="15sp"/>
            </LinearLayout>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="Password"
                android:textColor="@color/text_body_dark"
                android:textSize="12sp"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/brand_primary" app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#F0F9FF" app:hintEnabled="false"
                app:passwordToggleEnabled="true" app:passwordToggleTint="@color/brand_primary"
                app:startIconDrawable="@drawable/ic_lock" app:startIconTint="@color/brand_primary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Create password (min 6 chars)"
                    android:inputType="textPassword"
                    android:textColor="@color/text_h1"
                    android:textColorHint="@color/text_hint_color"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="Confirm Password"
                android:textColor="@color/text_body_dark"
                android:textSize="12sp"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/brand_primary" app:boxStrokeWidth="1.5dp"
                app:boxBackgroundColor="#F0F9FF" app:hintEnabled="false"
                app:passwordToggleEnabled="true" app:passwordToggleTint="@color/brand_primary"
                app:startIconDrawable="@drawable/ic_lock" app:startIconTint="@color/brand_primary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Repeat password"
                    android:inputType="textPassword"
                    android:textColor="@color/text_h1"
                    android:textColorHint="@color/text_hint_color"
                    android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Security badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/tint_primary"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pastel_blue"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/brand_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Your data is safe and encrypted"
                        android:textColor="@color/brand_primary_dark"
                        android:textSize="12sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Next button -->
            <TextView
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_create_account_btn"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Next →"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:elevation="4dp"/>

            <!-- Sign In link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Already have an account?  "
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Sign In"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
