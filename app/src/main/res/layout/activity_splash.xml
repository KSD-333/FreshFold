<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:fitsSystemWindows="false">

    <!-- Decorative background elements -->
    <View
        android:id="@+id/glowTop"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.15"
        android:background="@drawable/bg_quick_action_new"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="-100dp"
        android:layout_marginTop="-100dp" />

    <View
        android:id="@+id/glowBottom"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:alpha="0.12"
        android:background="@drawable/bg_quick_action_new"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="-80dp"
        android:layout_marginBottom="-80dp" />

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomInfoContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <!-- Logo container with glow ring -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/logoRing"
            android:layout_width="180dp"
            android:layout_height="180dp">

            <!-- Outer animated glow -->
            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:alpha="0.2"
                android:background="@drawable/bg_quick_action_new"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="130dp"
                android:layout_height="130dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="40dp"
                app:cardElevation="32dp"
                app:strokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/app_logo" />
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="FreshFold"
            android:textColor="#FFFFFF"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/tvAppTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.15"
            android:text="EXCELLENCE IN EVERY FOLD"
            android:textColor="#B8C0E0"
            android:textSize="13sp" />

        <View
            android:id="@+id/accentLine"
            android:layout_width="64dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_mint" />

    </LinearLayout>

    <!-- Content-rich Bottom Section -->
    <LinearLayout
        android:id="@+id/bottomInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="48dp"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Services Preview Icons -->
        <LinearLayout
            android:id="@+id/servicesIconRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:alpha="0.7"
            android:gravity="center">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/shirt"
                app:tint="#FFFFFF" />
            <View android:layout_width="24dp" android:layout_height="1dp" android:layout_marginHorizontal="8dp" android:background="#40FFFFFF" />
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/iron"
                app:tint="#FFFFFF" />
            <View android:layout_width="24dp" android:layout_height="1dp" android:layout_marginHorizontal="8dp" android:background="#40FFFFFF" />
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/shoeshine"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServiceList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:text="Dry Clean • Laundry • Ironing • Shoe Care"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

        <!-- Loading state -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loadingBar"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            app:indicatorColor="@color/brand_mint"
            app:trackColor="#20FFFFFF"
            app:trackCornerRadius="4dp"
            app:trackThickness="3dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
