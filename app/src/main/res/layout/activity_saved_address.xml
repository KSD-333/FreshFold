<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ══ HEADER — same style as My Cart page ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_cart_hero"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp">

                <!-- Back arrow -->
                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_back_btn_white"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Saved Address"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:letterSpacing="0.01"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- ══ FORM CARD ══ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Current address chip -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCurrentAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/tint_mint"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/brand_mint_dark"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/brand_mint_dark" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="CURRENT ADDRESS"
                                android:textColor="@color/brand_mint_dark"
                                android:textSize="9sp"
                                android:letterSpacing="0.06" />

                            <TextView
                                android:id="@+id/tvCurrentAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text=""
                                android:textColor="@color/text_h1"
                                android:textSize="12sp"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Update Address"
                    android:textColor="@color/text_h1"
                    android:textSize="15sp" />

                <!-- Geolocation Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetCurrentLocation"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:text="Use Current Location"
                    app:icon="@drawable/ic_location_pin"
                    app:iconGravity="textStart"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/brand_primary"
                    android:textColor="@color/brand_primary"
                    app:cornerRadius="14dp" />

                <!-- Select City -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCity"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:hint="Select City"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_primary"
                    app:boxBackgroundColor="#F0F9FF"
                    app:startIconDrawable="@drawable/ic_location_pin"
                    app:startIconTint="@color/brand_primary">
                    <AutoCompleteTextView
                        android:id="@+id/actvCity"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="none"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:textColor="@color/text_h1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Select Area / Locality -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilArea"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:hint="Select Area / Locality"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_primary"
                    app:boxBackgroundColor="#F0F9FF"
                    app:startIconDrawable="@drawable/ic_location_pin"
                    app:startIconTint="@color/brand_primary">
                    <AutoCompleteTextView
                        android:id="@+id/actvArea"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="none"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:textColor="@color/text_h1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Select Society -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSociety"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:hint="Select Society"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_primary"
                    app:boxBackgroundColor="#F0F9FF"
                    app:startIconDrawable="@drawable/ic_location_pin"
                    app:startIconTint="@color/brand_primary">
                    <AutoCompleteTextView
                        android:id="@+id/actvSociety"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:completionThreshold="1"
                        android:inputType="textCapWords"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:textColor="@color/text_h1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Select Building / Wing -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBuilding"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:hint="Building / Wing"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/brand_primary"
                    app:boxBackgroundColor="#F0F9FF">
                    <AutoCompleteTextView
                        android:id="@+id/actvBuilding"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="none"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:textColor="@color/text_h1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/layoutFloorFlat"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <!-- Select Floor -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFloor"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="6dp"
                        android:hint="Floor"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/brand_primary"
                        app:boxBackgroundColor="#F0F9FF">
                        <AutoCompleteTextView
                            android:id="@+id/actvFloor"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="none"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:textColor="@color/text_h1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Flat No. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFlat"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:hint="Flat No."
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/brand_primary"
                        app:boxBackgroundColor="#F0F9FF">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFlat"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="textCapCharacters"
                            android:textColor="@color/text_h1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Manual address fields -->
                <LinearLayout
                    android:id="@+id/layoutManualAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:hint="Society Name"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/brand_primary"
                        app:boxBackgroundColor="#F0F9FF">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etManualSociety"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="textCapWords"
                            android:textColor="@color/text_h1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Manual Building, Floor, Flat Fields -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:hint="Building / Wing"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/brand_primary"
                        app:boxBackgroundColor="#F0F9FF">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etManualBuilding"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="textCapWords"
                            android:textColor="@color/text_h1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="6dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="6dp"
                            android:hint="Floor"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxStrokeColor="@color/brand_primary"
                            app:boxBackgroundColor="#F0F9FF">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etManualFloor"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:inputType="number"
                                android:textColor="@color/text_h1"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="6dp"
                            android:hint="Flat No."
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxStrokeColor="@color/brand_primary"
                            app:boxBackgroundColor="#F0F9FF">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etManualFlat"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:inputType="textCapCharacters"
                                android:textColor="@color/text_h1"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Hidden city -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etManualCity"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text="Pune"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Save Address button -->
                <TextView
                    android:id="@+id/btnSaveAddress"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_create_account_btn"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="Save Address"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:elevation="4dp" />
                </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ PREVIOUS ADDRESSES SECTION ══ -->
        <LinearLayout
            android:id="@+id/layoutPreviousAddresses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-black"
                android:text="Previous Addresses"
                android:textColor="@color/text_h1"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPreviousAddresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
