<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme — Material3 with custom brand colors -->
    <style name="Base.Theme.Freshfold" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorPrimaryVariant">@color/brand_indigo_dark</item>
        <item name="colorSecondary">@color/brand_mint</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:colorBackground">@color/bg_app</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.Freshfold" parent="Base.Theme.Freshfold" />

    <style name="Theme.Freshfold.Login" parent="Base.Theme.Freshfold">
        <item name="android:windowBackground">@color/bg_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.Freshfold.Splash" parent="Base.Theme.Freshfold">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Thin divider used inside profile menu cards -->
    <style name="ProfileDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Input field style — filled with brand stroke -->
    <style name="InputField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/stroke_medium</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintEnabled">false</item>
    </style>

</resources>