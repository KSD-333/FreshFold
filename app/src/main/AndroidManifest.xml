<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Required for Razorpay to detect UPI apps like PhonePe on Android 11+ -->
    <queries>
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="in.org.npci.upiapp" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Freshfold">
        
        <activity
            android:name=".ui.home.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Freshfold.Login" />

        <activity
            android:name=".ui.home.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.RegistrationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.AddressActivity"
            android:exported="false" />



        <activity
            android:name=".DeliveryDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".PressmanDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".IroningConfirmationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.address.PickupSlotActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.ResetPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.services.ServiceDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.services.SteamIronInfoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.services.WashFoldInfoActivity"
            android:exported="false" />

        <activity android:name=".ui.services.WashIronInfoActivity" android:exported="false" />
        <activity android:name=".ui.services.DryCleanInfoActivity" android:exported="false" />
        <activity android:name=".ui.services.ShoeCareInfoActivity" android:exported="false" />
        <activity android:name=".ui.services.HomeAccessoriesInfoActivity" android:exported="false" />

        <activity
            android:name=".ui.profile.PersonalInfoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.SavedAddressActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.HelpSupportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.AboutUsActivity"
            android:exported="false" />

        <activity
            android:name=".OrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.cart.OrderSuccessActivity"
            android:exported="false" />

        <activity
            android:name=".ui.cart.OrderConfirmationActivity"
            android:exported="false" />

        <receiver
            android:name=".SmsBroadcastReceiver"
            android:exported="true"
            android:permission="com.google.android.gms.auth.api.phone.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.gms.auth.api.phone.SMS_RETRIEVED" />
            </intent-filter>
        </receiver>
            
    </application>

</manifest>